default partial alphanumeric_keys
xkb_symbols "basic" {

    include "level3(ralt_switch)"

    name[Group1] = "Kurdish (Kurmanji)";

    key <TLDE> {                                            [ grave,      asciitilde                 ] };
    key <AE01> {                                            [ 1,          exclam                     ] };
    key <AE02> {                                            [ 2,          at                         ] };
    key <AE03> {                                            [ 3,          numbersign                 ] };
    key <AE04> {                                            [ 4,          dollar                     ] };
    key <AE05> {                                            [ 5,          percent                    ] };
    key <AE06> {                                            [ 6,          asciicircum                ] };
    key <AE07> { type[Group1] = "FOUR_LEVEL",               [ 7,          ampersand,    braceleft    ] };
    key <AE08> { type[Group1] = "FOUR_LEVEL",               [ 8,          asterisk,     bracketleft  ] };
    key <AE09> { type[Group1] = "FOUR_LEVEL",               [ 9,          parenleft,    bracketright ] };
    key <AE10> { type[Group1] = "FOUR_LEVEL",               [ 0,          parenright,   braceright   ] };
    key <AE11> {                                            [ minus,      underscore                 ] };
    key <AE12> {                                            [ equal,      plus                       ] };

    key <AD01> {                                            [ q,          Q                          ] };
    key <AD02> {                                            [ w,          W                          ] };
    key <AD03> {                                            [ e,          E                          ] };
    key <AD04> {                                            [ r,          R                          ] };
    key <AD05> {                                            [ t,          T                          ] };
    key <AD06> {                                            [ y,          Y                          ] };
    key <AD07> {                                            [ u,          U                          ] };
    key <AD08> {                                            [ i,          I                          ] };
    key <AD09> {                                            [ o,          O                          ] };
    key <AD10> {                                            [ p,          P                          ] };
    key <AD11> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC",[ U00FB,      U00DB,        bracketleft  ] };
    key <AD12> { type[Group1] = "FOUR_LEVEL",               [ apostrophe, quotedbl,     bracketright ] };

    key <AC01> {                                            [ a,          A                          ] };
    key <AC02> {                                            [ s,          S                          ] };
    key <AC03> {                                            [ d,          D                          ] };
    key <AC04> {                                            [ f,          F                          ] };
    key <AC05> {                                            [ g,          G                          ] };
    key <AC06> {                                            [ h,          H                          ] };
    key <AC07> {                                            [ j,          J                          ] };
    key <AC08> {                                            [ k,          K                          ] };
    key <AC09> {                                            [ l,          L                          ] };
    key <AC10> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC",[ U00EA,      U00CA,        braceleft    ] };
    key <AC11> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC",[ U00EE,      U00CE,        braceright   ] };

    key <LSGT> {                                            [ less,       greater                    ] };
    key <AB01> {                                            [ z,          Z                          ] };
    key <AB02> {                                            [ x,          X                          ] };
    key <AB03> {                                            [ c,          C                          ] };
    key <AB04> {                                            [ v,          V                          ] };
    key <AB05> {                                            [ b,          B                          ] };
    key <AB06> {                                            [ n,          N                          ] };
    key <AB07> {                                            [ m,          M                          ] };
    key <AB08> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC",[ U00E7,      U00C7,        bar          ] };
    key <AB09> { type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC",[ U015F,      U015E,        semicolon    ] };
    key <AB10> { type[Group1] = "FOUR_LEVEL",               [ period,     question,     slash        ] };
    key <BKSL> { type[Group1] = "FOUR_LEVEL",               [ comma,      colon,        backslash    ] };
};
